# Copy to .env (never commit .env). EXPO_PUBLIC_* values ship inside the app, so only PUBLIC values go here.
# Supabase publishable/anon key only. NEVER the service_role key. Data is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Where email-confirmation / password-reset links return to (web build URL)
EXPO_PUBLIC_WEB_URL=https://lungstardaking.github.io/LSDK-Chat/
# Optional services (leave empty to disable)
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_LUNEX_URL=
